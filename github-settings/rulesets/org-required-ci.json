{
  "name": "REPO",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "repository_id": {
      "repository_ids": [
        0
      ]
    },
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH",
        "refs/heads/integration/**"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "workflows",
      "parameters": {
        "do_not_enforce_on_create": false,
        "workflows": [
          {
            "repository_id": 0,
            "path": ".github/workflows/ci.yml",
            "ref": "refs/heads/main"
          }
        ]
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_id": null,
      "actor_type": "OrganizationAdmin",
      "bypass_mode": "always"
    }
  ]
}
