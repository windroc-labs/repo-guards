{
  "format": ["rust", "python", "typescript", "tsx", "javascript", "jsx", "go"],
  "minTokens": 50,
  "minLines": 5,
  "ignore": [
    "**/tests/**",
    "**/__tests__/**",
    "**/test_*.py",
    "**/*_test.py",
    "**/*_test.rs",
    "**/*_test.go",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "gitignore": false,
  "baseline": "jscpd-baseline.json",
  "failOnNewClones": 0
}
