{
  "files": [
    "*.rs"
  ],
  "scopes": [
    "^\\s*(?:pub(?:\\([^)]*\\))?\\s+)?(?:(?:const|async|unsafe|extern\\s+\\\"[^\\\"]*\\\")\\s+)*fn\\s+(?P<name>\\w+)",
    "^\\s*(?:pub(?:\\([^)]*\\))?\\s+)?(?:mod|trait|struct|enum)\\s+(?P<name>\\w+)",
    "^\\s*impl(?:<[^>]*>)?\\s+(?:[\\w:<>, ]+\\s+for\\s+)?(?P<name>\\w+)"
  ],
  "skip_to_next": "\\s*(?:#\\[|//)",
  "exemptions": [
    {
      "tool": "lint",
      "pattern": "#\\[(?:allow|expect)\\((?P<codes>[^)]*)\\)",
      "next": true
    },
    {
      "tool": "lint",
      "pattern": "#!\\[(?:allow|expect)\\((?P<codes>[^)]*)\\)"
    },
    {
      "tool": "format",
      "pattern": "#!?\\[rustfmt::skip\\]",
      "next": true
    },
    {
      "tool": "coverage",
      "pattern": "coverage\\(off\\)",
      "next": true
    },
    {
      "tool": "skip",
      "pattern": "#\\[ignore\\b",
      "next": true
    },
    {
      "tool": "mutation",
      "pattern": "#\\[mutants::skip\\]",
      "next": true
    },
    {
      "tool": "generated",
      "pattern": "@generated"
    }
  ],
  "config_files": [
    "rustfmt.toml",
    ".rustfmt.toml",
    "clippy.toml",
    ".clippy.toml",
    ".cargo/config.toml",
    ".cargo/config",
    ".cargo/mutants.toml",
    "mutants.toml",
    "deny.toml",
    "rust-toolchain.toml",
    "rust-toolchain",
    ".config/nextest.toml",
    "build.rs"
  ]
}
