{
  "files": [
    "*.py",
    "*.pyi"
  ],
  "scopes": [
    "^\\s*(?:async\\s+)?def\\s+(?P<name>\\w+)",
    "^\\s*class\\s+(?P<name>\\w+)"
  ],
  "skip_to_next": "\\s*[#@]",
  "exemptions": [
    {
      "tool": "lint",
      "pattern": "#\\s*noqa(?::\\s*(?P<codes>[A-Z]+\\d+(?:\\s*,\\s*[A-Z]+\\d+)*))?"
    },
    {
      "tool": "lint",
      "pattern": "#\\s*(?:ruff|flake8)\\s*:\\s*noqa(?::\\s*(?P<codes>[A-Z]+\\d+(?:\\s*,\\s*[A-Z]+\\d+)*))?"
    },
    {
      "tool": "lint",
      "pattern": "#\\s*pylint:\\s*disable=(?P<codes>[\\w-]+(?:\\s*,\\s*[\\w-]+)*)"
    },
    {
      "tool": "type",
      "pattern": "#\\s*type:\\s*ignore(?:\\[(?P<codes>[^\\]]*)\\])?"
    },
    {
      "tool": "type",
      "pattern": "#\\s*pyright:\\s*ignore(?:\\[(?P<codes>[^\\]]*)\\])?"
    },
    {
      "tool": "type",
      "pattern": "#\\s*pyright:\\s*(?P<codes>basic|standard|off)\\b"
    },
    {
      "tool": "format",
      "pattern": "#\\s*fmt:\\s*(?P<codes>off|skip)\\b"
    },
    {
      "tool": "coverage",
      "pattern": "(?i:#\\s*pragma:?\\s*no\\s*cover)"
    },
    {
      "tool": "skip",
      "pattern": "@pytest\\.mark\\.(?P<codes>skip|skipif|xfail)\\b",
      "next": true
    },
    {
      "tool": "skip",
      "pattern": "\\bpytest\\.(?P<codes>skip|xfail)\\("
    },
    {
      "tool": "skip",
      "pattern": "@unittest\\.(?P<codes>skip\\w*)",
      "next": true
    },
    {
      "tool": "mutation",
      "pattern": "#\\s*pragma:\\s*no\\s*mutate"
    },
    {
      "tool": "generated",
      "pattern": "@generated"
    }
  ],
  "config_files": [
    "pyproject.toml",
    "ruff.toml",
    ".ruff.toml",
    "setup.cfg",
    "tox.ini",
    "pytest.ini",
    "conftest.py",
    ".coveragerc",
    "mypy.ini",
    ".mypy.ini",
    "pyrightconfig.json",
    "sitecustomize.py",
    "usercustomize.py"
  ]
}
