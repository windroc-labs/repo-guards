{
  "languages": [
    "rust"
  ],
  "allowed_config_paths": [
    "Cargo.toml",
    "rustfmt.toml",
    "clippy.toml",
    "deny.toml",
    "rust-toolchain.toml"
  ],
  "exemptions": [
    {
      "tool": "lint",
      "path": "src/ffi.rs",
      "code": "non_camel_case_types",
      "count": 1,
      "reason": "C names in the generated bindings",
      "scope": "ffi"
    }
  ]
}
